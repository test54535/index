mq.addEventListener('change',autoTheme);autoTheme();
$('#auto').checked=LS.get('pn_auto',false);$('#auto').onchange=e=>{LS.set('pn_auto',e.target.checked);autoTheme()};
$('#snd').checked=LS.get('pn_snd',true);$('#snd').onchange=e=>LS.set('pn_snd',e.target.checked);

/* ===== ACCESS + DATA ===== */
let room,notes={},ref=null,color='c-red',listMode=false,privRoom=false;
let stRef=null,stickers={},trRef=null,trash={},curRef=null,prRef=null,db=null,loaded=false;
let board='main',boardList={main:{name:'Main'}};
const stSeen=new Set(),seen=new Set(),offs=[];
const myId=Math.random().toString(36).slice(2,9);let myName='Guest';
const hue=id=>[...String(id)].reduce((a,c)=>a+c.charCodeAt(0)*37,0)%360;
const bpath=()=>'rooms/'+room+(board==='main'?'':'/boards/'+board);
const lk=p=>p+room+(board==='main'?'':'_'+board);
let ANCH=500;const PW=()=>document.documentElement.clientWidth;
/* ANCH = top of the notes area (right under title/composer/toolbar/polls): notes can never go above it */
const syncAnch=()=>{const w=document.getElementById('wrap');if(w)ANCH=Math.round(w.getBoundingClientRect().top+(window.scrollY||0))+6};
/* columns of the default grid depend on screen width (1 column on phones) */
const gridCols=()=>Math.max(1,Math.min(4,Math.floor((PW()-16)/216)));
const gridCx=i=>(i%gridCols())*216-Math.round((gridCols()*216-8)/2);
const gridTy=i=>8+Math.floor(i/gridCols())*200;
const safeImg=s=>typeof s==='string'&&s.length<(s.startsWith('data:image/gif')?7000000:400000)&&/^data:image\/(webp|png|jpeg|gif);base64,[A-Za-z0-9+\/=]+$/.test(s);
const UID_RE=/^[a-hj-km-np-z2-9]{7}$/;
const genUid=()=>{const A='abcdefghjkmnpqrstuvwxyz23456789';for(;;){const u=[...crypto.getRandomValues(new Uint8Array(7))].map(b=>A[b%31]).join('');if(/\d/.test(u)&&/[a-z]/.test(u))return u}};
const uid=(()=>{let u=LS.get('pn_uid',null);if(typeof u==='string'&&UID_RE.test(u))return u;
  u=genUid();LS.set('pn_uid',u);
  try{Object.keys(localStorage).filter(k=>/^pn_s_(fr|rin|rout|q|dm_)/.test(k)).forEach(k=>localStorage.removeItem(k))}catch{}
  return u})();
/* big images (GIF banners...) live in IndexedDB: localStorage is far too small for them */
const idb={db:null,open(){return this.db||(this.db=new Promise(res=>{try{const r=indexedDB.open('pn_img',1);r.onupgradeneeded=()=>r.result.createObjectStore('k');r.onsuccess=()=>res(r.result);r.onerror=()=>res(null)}catch{res(null)}}))},
  async get(k){const d=await this.open();if(!d)return null;return new Promise(res=>{try{const q=d.transaction('k').objectStore('k').get(k);q.onsuccess=()=>res(q.result==null?null:q.result);q.onerror=()=>res(null)}catch{res(null)}})},
  async set(k,v){const d=await this.open();if(!d)return false;return new Promise(res=>{try{const t=d.transaction('k','readwrite');t.objectStore('k').put(v,k);t.oncomplete=()=>res(true);t.onerror=()=>res(false);t.onabort=()=>res(false)}catch{res(false)}})}};
const imgSet=async(k,v)=>{if(await idb.set(k,v))return;if(typeof v==='string'&&v.length<1500000)LS.set('pn_i_'+k,v)};
const imgGet=async k=>(await idb.get(k))||LS.get('pn_i_'+k,'')||'';
const myBanner=async()=>(await imgGet('ban_'+uid))||LS.get('pn_banner','')||'';
const myProf=LS.get('pn_prof',null)||{name:LS.get('pn_name','')||'Guest '+Math.floor(10+Math.random()*90),bio:'',pfp:'',bc:'#f0455a'};
myName=myProf.name;const profs={[uid]:myProf};
if(FIREBASE_CONFIG&&typeof firebase!=='undefined'){try{firebase.initializeApp(FIREBASE_CONFIG);db=firebase.database()}catch(e){console.error(e)}}

/* lobby */
let lastPres={};
function showOnline(o){
  lastPres=o||{};const list=Object.entries(lastPres),box=$('#online');box.innerHTML='';
  box.append(el('span','live'),el('span',null,(privRoom?'🔒 ':'')+'Lobby: '+list.length+' online'));
  list.forEach(([id,u])=>{u=u||{};const fr=u.uid&&friends[u.uid],a=av(u.uid,u.name||'Guest','');
    if(id===myId)a.classList.add('me');if(fr)a.classList.add('fr');
    a.title=(u.name||'Guest')+(id===myId?' (you)':'')+(fr?' - friend':'');box.append(a)});
  const ty=list.filter(([id,u])=>id!==myId&&u&&u.typing&&Date.now()-u.typing<5000).map(([,u])=>u.name||'Guest');
  if(ty.length)box.append(el('span','typing','✍️ '+ty.join(', ')+(ty.length>1?' are':' is')+' typing...'));
  if(!SYNC){const st=db&&db.state;box.append(el('span',null,st?(st.connected?'(sync off · live p2p)':(st.err?'(sync off · p2p error: '+st.err+')':'(sync off · waiting for friends)')):'(sync off)'))}
  loadProfiles(list.map(([,u])=>u&&u.uid));
  renderPlayers();
}
