  return api}

async function sha(s){const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));return[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('').slice(0,32)}
async function enter(code,pw){
  code=code.trim().toLowerCase();pw=String(pw||'').slice(0,64);
  if(!code){const b=$('.gate .box');b.classList.remove('shake');void b.offsetWidth;b.classList.add('shake');return}
  const eb=$('#enter');eb.classList.add('go');eb.textContent='Entering…';
  const okN=await tryRename($('#name').value);
  if(!okN){eb.classList.remove('go');eb.textContent='Enter';return}
  myName=myProf.name;
  /* private room without sync: the password is part of the room key (and of the p2p hub id),
     so strangers without it can't even find the room */
  privRoom=!SYNC&&p2pPref()&&!!pw;
  room=await sha(privRoom?code+'\u0000pw:'+pw:code);
  if(window.pnRoomGate&&!(await pnRoomGate(room,code))){eb.classList.remove('go');eb.textContent='Enter';room=undefined;privRoom=false;return}
  LS.set('pn_code',code);if(privRoom)LS.set('pn_rpw',pw);else try{localStorage.removeItem('pn_rpw')}catch{}
  inRoom=true;
  board=LS.get('pn_board_'+room,'main');
  if(!db&&p2pPref()){db=makeP2P(room);
    db.onConnect=()=>{db.ref('users/'+uid+'/p').set(myProf);myBanner().then(bn=>{if(bn)db.ref('users/'+uid+'/banner').set(bn)})};
    db.onConnect()}
  if(db){setBoards({});db.ref('rooms/'+room+'/boardlist').on('value',s=>setBoards(s.val()))}
  else setBoards(LS.get('pn_bl_'+room,{}));
  bind();trackPresence();startChat();
  $('#gate').classList.add('out');document.body.classList.add('entered');
}

