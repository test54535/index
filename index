/* ===== LIVE ROOMS WITHOUT SYNC (peer-to-peer) =====
   When Firebase sync is OFF, a room can still be shared live: browsers that enter the
   same access code connect directly (WebRTC via PeerJS). It mimics the small part of the
   Firebase API this app uses, keeps everything in memory and mirrors it to localStorage. */
const SYNC=!!db;
const TURN={username:'openrelayproject',credential:'openrelayproject'};
const PEER_OPTS={config:{iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun1.l.google.com:19302'},{urls:'stun:global.stun.twilio.com:3478'},
  {urls:'turn:openrelay.metered.ca:80',...TURN},{urls:'turn:openrelay.metered.ca:443',...TURN},{urls:'turns:openrelay.metered.ca:443?transport=tcp',...TURN}]}};
const p2pPref=()=>LS.get('pn_p2p',true)!==false;
function makeP2P(room){
  const R='rooms/'+room+'/',hubId='pn-'+room,root={},L=[],myOds=[],connOds=new Map(),conns=new Map();
  const COLL=new Set(['notes','stickers','trash','chat','presence','cursors','boardlist','pp']);
  let peer=null,isHub=false,hubConn=null,dead=false,infoCbs=[],pT=null,lastErr='';
  const split=p=>String(p).split('/').filter(Boolean);
  const clone=v=>v===undefined?undefined:JSON.parse(JSON.stringify(v));
  const norm=p=>{const m=/^users\/([^/]+)\/(p|banner)$/.exec(p);return m?R+'pp/'+m[1]+'/'+m[2]:p};
  const okPath=p=>typeof p==='string'&&p.startsWith(R)&&p.length<300&&!p.includes('..');
  const getAt=p=>{let n=root;for(const k of split(p)){if(n==null||typeof n!=='object')return undefined;n=n[k]}return n};
  function setAt(p,v){const ks=split(p);if(!ks.length)return;const st=[root];let n=root;
    for(let i=0;i<ks.length-1;i++){const k=ks[i];if(n[k]==null||typeof n[k]!=='object')n[k]={};n=n[k];st.push(n)}
    const last=ks[ks.length-1];if(v==null)delete n[last];else n[last]=clone(v);
    for(let i=ks.length-1;i>0;i--){if(Object.keys(st[i]).length)break;delete st[i-1][ks[i-1]]}}
  const snap=p=>{const v=getAt(p),ks=split(p);return{val:()=>clone(v),exists:()=>v!=null,key:ks[ks.length-1]||null}};
  const related=(a,b)=>{const x=split(a),y=split(b),n=Math.min(x.length,y.length);for(let i=0;i<n;i++)if(x[i]!==y[i])return false;return true};
  function dispatch(l){try{
    if(l.type==='value'){l.cb(snap(l.path));return}
    if(l.type!=='child_added')return;
    const v=getAt(l.path);let keys=v&&typeof v==='object'?Object.keys(v).sort():[];if(l.limit)keys=keys.slice(-l.limit);
    keys.filter(k=>!l.known.has(k)).forEach(k=>{l.known.add(k);l.cb(snap(l.path+'/'+k))});
    [...l.known].forEach(k=>{if(!keys.includes(k))l.known.delete(k)})
  }catch(e){console.error(e)}}
  const fire=p=>{L.slice().forEach(l=>{if(l.on&&related(p,l.path))dispatch(l)})};
  function saveLocal(){const rt=getAt('rooms/'+room)||{};
    LS.set('pn_'+room,rt.notes||{});LS.set('pn_st_'+room,rt.stickers||{});LS.set('pn_tr_'+room,rt.trash||{});LS.set('pn_bl_'+room,rt.boardlist||{});
    Object.entries(rt.boards||{}).forEach(([b,d])=>{d=d||{};LS.set('pn_'+room+'_'+b,d.notes||{});LS.set('pn_st_'+room+'_'+b,d.stickers||{});LS.set('pn_tr_'+room+'_'+b,d.trash||{})})}
  function persistSoon(p){const rel=p.slice(R.length);
    if(/^(notes|stickers|trash|boardlist|boards)(\/|$)/.test(rel)&&!/(^|\/)cursors(\/|$)/.test(rel)){clearTimeout(pT);pT=setTimeout(saveLocal,250)}}
  function loadLocal(){const bl=LS.get('pn_bl_'+room,{});
    ['main',...Object.keys(bl).filter(k=>k!=='main')].forEach(b=>{const sfx=b==='main'?'':'_'+b,base=b==='main'?'rooms/'+room:'rooms/'+room+'/boards/'+b;
      [['pn_','notes'],['pn_st_','stickers'],['pn_tr_','trash']].forEach(([pre,key])=>{const d=LS.get(pre+room+sfx,{});if(d&&Object.keys(d).length)setAt(base+'/'+key,d)})});
    Object.entries(bl).forEach(([id,v])=>{if(id!=='main')setAt('rooms/'+room+'/boardlist/'+id,v)})}
  function sendW(m,except){
    if(isHub)conns.forEach((c,id)=>{if(id!==except&&c.open)c.send(m)});
    else if(hubConn&&hubConn.open)hubConn.send(m)}
  function write(p,v){p=norm(p);v=v==null?null:v;setAt(p,v);fire(p);persistSoon(p);if(p.startsWith(R))sendW({k:'w',p,v},null)}
  function ownTree(){const t=clone(getAt('rooms/'+room))||{};delete t.presence;delete t.cursors;
    Object.values(t.boards||{}).forEach(b=>{if(b)delete b.cursors});return t}
  function mergeTree(tree,wins,out){(function walk(rel,rv){
    const isRec=rel.length>=2&&COLL.has(rel[rel.length-2]);
    if(rv&&typeof rv==='object'&&!Array.isArray(rv)&&!isRec){Object.keys(rv).forEach(k=>walk(rel.concat(k),rv[k]));return}
    if(rv==null)return;const p=R+rel.join('/'),cur=getAt(p);
    if(cur===undefined||(wins&&JSON.stringify(cur)!==JSON.stringify(rv))){setAt(p,rv);fire(p);persistSoon(p);if(out)out.push([p,rv])}
  })([],tree||{})}
  const infoFire=()=>infoCbs.slice().forEach(o=>{try{o.cb({val:()=>true,exists:()=>true})}catch(e){console.error(e)}});
  function status(){const cn=isHub?conns.size>0:!!hubConn;if(cn)lastErr='';api.state={connected:cn,hub:isHub,peers:conns.size,err:lastErr};try{showOnline(lastPres)}catch{}}
  function applyOds(id,announce){const ods=connOds.get(id)||[];connOds.delete(id);
    ods.forEach(o=>{const v=o.op==='set'?o.v:null;setAt(o.p,v);fire(o.p);persistSoon(o.p);if(announce)sendW({k:'w',p:o.p,v:v==null?null:v},null)})}
  function onMsg(c,m){if(!m||typeof m!=='object')return;
    if(m.k==='w'){if(!okPath(m.p))return;setAt(m.p,m.v);fire(m.p);persistSoon(m.p);if(isHub)sendW(m,c.peer)}
    else if(m.k==='hello'){if(!isHub)return;c.send({k:'snap',tree:clone(getAt('rooms/'+room))||{}});myOds.forEach(o=>c.send({k:'od',p:o.p,op:o.op,v:o.v}));infoFire()}
    else if(m.k==='snap'){mergeTree(m.tree,true,null);try{api.onConnect&&api.onConnect()}catch(e){console.error(e)}c.send({k:'snap2',tree:ownTree()});infoFire();status()}
    else if(m.k==='snap2'){if(!isHub)return;const out=[];mergeTree(m.tree,false,out);out.forEach(([p,v])=>sendW({k:'w',p,v},c.peer))}
    else if(m.k==='od'){if(!okPath(m.p))return;if(!connOds.has(c.peer))connOds.set(c.peer,[]);connOds.get(c.peer).push({p:m.p,op:m.op,v:m.v})}}
  function becomeHub(pr){isHub=true;peer=pr;
    pr.on('connection',c=>{
      c.on('open',()=>{conns.set(c.peer,c);status()});
      c.on('data',m=>onMsg(c,m));
      const drop=()=>{if(conns.get(c.peer)!==c)return;conns.delete(c.peer);applyOds(c.peer,true);status()};
      c.on('close',drop);c.on('error',drop)});
    pr.on('disconnected',()=>{try{pr.reconnect()}catch{}});
    infoFire();status()}
  function retry(ms){if(!dead)setTimeout(start,ms)}
  function joinClient(){isHub=false;const pr=new Peer(undefined,PEER_OPTS);peer=pr;
    const giveUp=setTimeout(()=>{if(!hubConn&&!dead){try{pr.destroy()}catch{}retry(500+Math.random()*1500)}},12000);
    pr.on('open',()=>{const c=pr.connect(hubId,{reliable:true});
      c.on('open',()=>{clearTimeout(giveUp);hubConn=c;c.send({k:'hello'});myOds.forEach(o=>c.send({k:'od',p:o.p,op:o.op,v:o.v}));status()});
      c.on('data',m=>onMsg(c,m));
      const lost=()=>{if(hubConn!==c)return;hubConn=null;applyOds(c.peer,false);status();try{pr.destroy()}catch{}retry(400+Math.random()*1600)};
      c.on('close',lost);c.on('error',lost)});
    pr.on('error',e=>{if(e&&e.type&&e.type!=='peer-unavailable'){lastErr=e.type;status()}if(e&&e.type==='peer-unavailable'){clearTimeout(giveUp);try{pr.destroy()}catch{}retry(200+Math.random()*600)}else console.warn('p2p',e)})}
  function start(){if(dead)return;
    if(typeof Peer==='undefined'){status();return}
    let pr,opened=false;try{pr=new Peer(hubId,PEER_OPTS)}catch(e){console.error(e);retry(5000);return}
    pr.on('open',()=>{opened=true;becomeHub(pr)});
    pr.on('error',e=>{if(e&&e.type&&e.type!=='unavailable-id'){lastErr=e.type;status()}if(opened){console.warn('p2p',e);return}try{pr.destroy()}catch{}
      if(e&&e.type==='unavailable-id')joinClient();else retry(4000+Math.random()*3000)})}
  function mkRef(p,lim){p=norm(p);const self={path:p,
    child:c=>mkRef(p+'/'+c),
    set:v=>{write(p,v);return Promise.resolve()},
    remove:()=>{write(p,null);return Promise.resolve()},
    push:v=>{const k=Date.now().toString(36).padStart(9,'0')+Math.random().toString(36).slice(2,6),r=mkRef(p+'/'+k);if(v!==undefined)r.set(v);return Promise.resolve(r)},
    on:(t,cb)=>{
      if(p==='.info/connected'){infoCbs.push({cb,owner:self});setTimeout(()=>{if(infoCbs.some(o=>o.cb===cb))try{cb({val:()=>true,exists:()=>true})}catch(e){console.error(e)}},0);return cb}
      const l={path:p,type:t,cb,limit:lim,known:new Set(),on:true,owner:self};L.push(l);setTimeout(()=>{if(l.on)dispatch(l)},0);return cb},
    once:()=>Promise.resolve(snap(p)),
    off:()=>{L.forEach(l=>{if(l.owner===self)l.on=false});for(let i=L.length-1;i>=0;i--)if(!L[i].on)L.splice(i,1);infoCbs=infoCbs.filter(o=>o.owner!==self)},
    limitToLast:n=>mkRef(p,n),
    onDisconnect:()=>{const add=o=>{if(!myOds.some(x=>x.p===o.p&&x.op===o.op))myOds.push(o);
        const m={k:'od',p:o.p,op:o.op,v:o.v};if(isHub)conns.forEach(c=>c.open&&c.send(m));else if(hubConn&&hubConn.open)hubConn.send(m);return Promise.resolve()};
      return{remove:()=>add({p,op:'remove'}),set:v=>add({p,op:'set',v})}}};
    return self}
  const api={p2p:true,state:{connected:false,hub:false,peers:0},ref:p=>mkRef(p),onConnect:null,
    stop(){dead=true;try{peer&&peer.destroy()}catch{}}};
