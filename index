 tiedye:[
  {id:'t-rainbow',name:'Rainbow',bg:'radial-gradient(circle at 20% 25%,#ff5f6d 0,transparent 40%),radial-gradient(circle at 80% 20%,#ffd36e 0,transparent 40%),radial-gradient(circle at 70% 80%,#5ee7a5 0,transparent 45%),radial-gradient(circle at 25% 80%,#6aa8ff 0,transparent 45%),#f6f0ff',accent:'#8a3ffc',line:'rgba(0,0,0,.06)'},
  {id:'t-sunset',name:'Sunset',bg:'radial-gradient(circle at 30% 20%,#ff8a5c 0,transparent 45%),radial-gradient(circle at 80% 30%,#ff4d8d 0,transparent 45%),radial-gradient(circle at 50% 90%,#ffd166 0,transparent 50%),#ffe9dc',accent:'#d9366b',line:'rgba(0,0,0,.06)'},
  {id:'t-ocean',name:'Ocean',bg:'radial-gradient(circle at 25% 25%,#4cc9f0 0,transparent 45%),radial-gradient(circle at 80% 35%,#4361ee 0,transparent 45%),radial-gradient(circle at 40% 90%,#80ffdb 0,transparent 50%),#e6f4ff',accent:'#3a56d4',line:'rgba(0,0,0,.06)'},
  {id:'t-candy',name:'Candy',bg:'radial-gradient(circle at 20% 30%,#ff9ad5 0,transparent 42%),radial-gradient(circle at 80% 25%,#b8a1ff 0,transparent 42%),radial-gradient(circle at 60% 85%,#9bf6ff 0,transparent 48%),#fff0fa',accent:'#c13fb0',line:'rgba(0,0,0,.06)'}]
};
const ICON=document.querySelector('link[rel=icon]').href;
