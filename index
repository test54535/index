const LS={get:(k,d)=>{try{return JSON.parse(localStorage.getItem(k))??d}catch{return d}},set:(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch{}}};
const el=(t,c,x)=>{const e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e};

/* ===== THEMES ===== */
function applyTheme(t,tmp){
  const r=document.documentElement.style;
  r.setProperty('--bg',t.bg);r.setProperty('--accent',t.accent);r.setProperty('--line',t.line);
  r.setProperty('--text',t.dark?'#fff':'#2b2b2b');
  document.body.style.background=t.bg;document.body.style.backgroundAttachment='fixed';
  document.body.style.backgroundSize=t.bg.startsWith('url')?'cover':'';
  document.querySelectorAll('.sw').forEach(b=>b.classList.toggle('sel',b.dataset.id===t.id));
  document.body.classList.toggle('dk',!!t.dark);
  if(!tmp)LS.set('pn_theme',t);
}
let n_=0;
Object.entries(THEMES).forEach(([g,list])=>list.forEach(t=>{
  const b=el('button','sw');b.dataset.id=t.id;b.style.background=t.bg;b.style.setProperty('--i',n_++);
  b.append(el('span',null,t.name));b.onclick=()=>applyTheme(t);$('#g-'+g).append(b);
}));
const lum=h=>{const n=parseInt(h.slice(1),16);return(.299*(n>>16)+.587*(n>>8&255)+.114*(n&255))/255};
$('#applyC').onclick=()=>{const a=$('#c1').value,b=$('#c2').value;
  applyTheme({id:'custom',bg:`linear-gradient(135deg,${a},${b})`,accent:lum(a)>.7?'#444':a,line:'rgba(255,255,255,.12)',dark:(lum(a)+lum(b))/2<.5})};
$('#imgBtn').onclick=()=>$('#img').click();
$('#img').onchange=e=>{const f=e.target.files[0];if(!f)return;const im=new Image();
  im.onload=()=>{const s=Math.min(1,1400/Math.max(im.width,im.height)),c=document.createElement('canvas');
    c.width=im.width*s;c.height=im.height*s;c.getContext('2d').drawImage(im,0,0,c.width,c.height);
    applyTheme({id:'photo',bg:`url(${c.toDataURL('image/jpeg',.7)}) center/cover`,accent:'#f0455a',line:'transparent',dark:0})};
  im.src=URL.createObjectURL(f)};
const open_=v=>{$('#overlay').classList.toggle('open',v);document.body.classList.toggle('open',v)};
$('#gear').onclick=()=>open_(!$('#overlay').classList.contains('open'));
$('#resume').onclick=()=>{const b=$('#resume');b.classList.add('press');setTimeout(()=>{open_(false);b.classList.remove('press')},150)};
$('#overlay').onclick=e=>{if(e.target.id==='overlay')open_(false)};
addEventListener('keydown',e=>{if(e.key==='Escape'){open_(false);$('#drawOv').classList.remove('open');pOv.classList.remove('open');openChat(false)}});
const mq=matchMedia('(prefers-color-scheme: dark)'),DARK=THEMES.classic.find(t=>t.id==='dark');
