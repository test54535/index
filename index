<style>
:root{--accent:#f0455a;--text:#2b2b2b;--line:rgba(0,0,0,.07);--bg:#fdfdfd;--ease:cubic-bezier(.2,.8,.2,1)}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
body{position:relative;font-family:'Fira Code',monospace;color:var(--text);background:var(--bg);background-attachment:fixed;min-height:100vh;padding:24px 16px 80px;transition:color .4s}
.lines::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;background:repeating-linear-gradient(to bottom,transparent 0 15px,var(--line) 15px 16px)}
main{position:relative;z-index:1;max-width:1000px;margin:0 auto;text-align:center}
h1,.gate h1{display:inline-block;margin:28px 0 10px;padding:8px 22px;font:800 28px 'Rubik',sans-serif;letter-spacing:1px;color:var(--accent);background:#fff;border:3px solid var(--accent);box-shadow:4px 4px 0 rgba(0,0,0,.12);transition:color .4s,border-color .4s}
.sub{display:inline-block;font-size:11px;font-style:italic;margin:0 0 24px;padding:2px 8px;border-radius:6px;background:rgba(255,255,255,.35)}
button{font-family:inherit}
/* composer */
.composer{width:min(92vw,380px);margin:0 auto 24px;padding:10px;background:#fff;color:#222;border:1px solid #e3e3e3;border-radius:12px;box-shadow:0 6px 18px rgba(0,0,0,.1);text-align:left}
.composer textarea{width:100%;height:60px;resize:none;padding:6px 8px;font:11px 'Fira Code',monospace;background:#fafafa;border:1px solid #ddd;border-radius:6px}
.composer textarea:focus,.gate input:focus{outline:2px solid var(--accent);outline-offset:1px}
.row{display:flex;align-items:center;gap:8px;margin-top:8px;flex-wrap:wrap}
.dot{width:16px;height:16px;border-radius:50%;border:2px solid transparent;cursor:pointer;padding:0;transition:transform .2s var(--ease)}
.dot:hover{transform:scale(1.25)}.dot.sel{border-color:#111}
.chip{border:1px solid #ccc;background:#fff;border-radius:6px;padding:3px 8px;font-size:10px;cursor:pointer;transition:all .2s}
.chip.on{background:#222;color:#fff}
input[type=datetime-local]{font:10px 'Fira Code',monospace;border:1px solid #ccc;border-radius:6px;padding:2px 4px}
.btn{border:0;border-radius:6px;padding:6px 12px;background:var(--accent);color:#fff;font-size:11px;cursor:pointer;transition:transform .15s,filter .2s}
.btn:hover{filter:brightness(1.1)}.btn:active{transform:scale(.94)}
#add{margin-left:auto}
/* board */
#wrap{min-height:520px}
#board,#stickers,#cursors{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none}
#board{z-index:5}#stickers{z-index:6}#cursors{z-index:30}
.note{pointer-events:auto;position:absolute;width:200px;min-height:120px;padding:8px 12px 12px;text-align:left;border-radius:4px;font-size:12px;box-shadow:2px 4px 10px rgba(0,0,0,.18);color:#222;transform:rotate(var(--r,0deg));transition:box-shadow .2s,transform .2s;z-index:1}
.note.pinned{z-index:3}.note.drag{z-index:9;box-shadow:6px 12px 24px rgba(0,0,0,.3);transform:rotate(0) scale(1.04);transition:none}
.note.new{animation:pop .45s var(--ease)}
@keyframes pop{from{opacity:0;transform:scale(.6) rotate(-8deg)}}
.note.due{animation:pulse 1.2s infinite}
@keyframes pulse{50%{box-shadow:0 0 0 4px var(--accent),2px 4px 10px rgba(0,0,0,.18)}}
.bar{display:flex;gap:6px;align-items:center;margin-bottom:4px}
.grip{cursor:grab;touch-action:none;flex:1;opacity:.45;user-select:none;font-size:14px}
.bar button{border:0;background:none;cursor:pointer;font-size:13px;opacity:.55;padding:0;transition:opacity .2s,transform .2s}
.bar button:hover{opacity:1;transform:scale(1.2)}
.pinned .pin{opacity:1}
.txt{white-space:pre-wrap;word-break:break-word;min-height:50px;outline:none}
.item{display:flex;gap:6px;align-items:flex-start;margin:3px 0}.item.d span{text-decoration:line-through;opacity:.5}
.due-b{font-size:10px;margin-top:6px;opacity:.75}
.reacts{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;max-width:100%}
.reacts button{border:0;border-radius:10px;background:rgba(255,255,255,.55);font-size:11px;padding:1px 6px;cursor:pointer;transition:transform .15s;flex:0 0 auto}
body.no-rx .reacts{display:none}
.reacts button:hover{transform:scale(1.15)}
.c-red{background:#ff8a8a}.c-blue{background:#8cc8f5}.c-green{background:#8cf0c8}
.dot.c-red{background:#f26b6b}.dot.c-blue{background:#6ab4ee}.dot.c-green{background:#5ef0c0}
.empty{opacity:.7;font-size:12px;padding-top:30px}
/* gear + settings */
#gear{position:fixed;top:14px;right:14px;z-index:20;width:30px;height:30px;border-radius:50%;border:2px solid var(--accent);background:#fff;font-size:15px;line-height:1;cursor:pointer;padding:0;transition:transform .6s var(--ease)}
#gear:hover{transform:rotate(90deg)}body.open #gear{transform:rotate(180deg)}
#overlay,#drawOv,#pOv{position:fixed;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(0,0,0,0);backdrop-filter:blur(0);visibility:hidden;transition:all .35s var(--ease)}
#overlay.open,#drawOv.open,#pOv.open{visibility:visible;background:rgba(0,0,0,.35);backdrop-filter:blur(4px)}
.panel{width:min(100%,480px);max-height:85vh;overflow:auto;padding:20px;background:#fff;color:#222;border-radius:14px;box-shadow:0 12px 40px rgba(0,0,0,.3);opacity:0;transform:translateY(24px) scale(.94);transition:all .4s var(--ease)}
#overlay.open .panel,#drawOv.open .panel,#pOv.open .panel{opacity:1;transform:none}
.panel header{display:flex;justify-content:space-between;align-items:center}
.panel h2{margin:0;font:800 18px 'Rubik',sans-serif}.panel h3{margin:16px 0 8px;font-size:13px}
#close{border:0;background:none;font-size:20px;cursor:pointer;transition:transform .3s}#close:hover{transform:rotate(90deg)}
.sws{display:flex;flex-wrap:wrap;gap:10px;padding-bottom:20px}
.sw{width:64px;height:64px;border-radius:10px;border:3px solid transparent;cursor:pointer;padding:0;position:relative;box-shadow:0 0 0 1px #ccc inset;opacity:0;transform:scale(.7);transition:transform .25s var(--ease),border-color .2s}
#overlay.open .sw{opacity:1;transform:none;transition:opacity .4s calc(var(--i)*40ms+150ms),transform .4s var(--ease) calc(var(--i)*40ms+150ms)}
#overlay.open .sw:hover{transform:scale(1.1);transition-delay:0s}
.sw.sel{border-color:#111}.sw span{position:absolute;left:-4px;right:-4px;bottom:-18px;text-align:center;font-size:9px;color:#444}
.custom{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:11px}
.custom input[type=color]{width:36px;height:30px;border:0;padding:0;background:none}
.tools{display:flex;gap:8px;flex-wrap:wrap}.tools .btn{background:#222}
/* social */
#pOv{z-index:60}
.av{cursor:pointer}.av.xs{width:16px;height:16px;font-size:9px;border-width:1px;box-shadow:none}
.av.on,.av.off{position:relative}.av.off{opacity:.5}
.av.on::after{content:"";position:absolute;right:-3px;bottom:-3px;width:9px;height:9px;border-radius:50%;background:#2ecc71;border:2px solid #fff}
.av.fr{box-shadow:0 0 0 2px #ff6b81}
.strip{display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap;margin:-8px auto 16px;width:max-content;max-width:92vw;padding:3px 10px;border-radius:16px;background:rgba(255,255,255,.6);color:#222;font-size:11px}
.gate .strip{margin:0}
#chatBtn{position:fixed;top:14px;left:14px;z-index:60;width:30px;height:30px;border-radius:50%;border:2px solid var(--accent);background:#fff;font-size:14px;line-height:1;cursor:pointer;padding:0;transition:transform .3s var(--ease)}
#chatBtn:hover{transform:scale(1.12)}
#chatBtn i,#chat .tab i{font:700 10px/16px sans-serif;font-style:normal;min-width:16px;height:16px;padding:0 4px;border-radius:8px;background:#e03a3a;color:#fff;text-align:center}
#chatBtn i{position:absolute;top:-7px;right:-7px}#chat .tab i{display:inline-block;margin-left:4px}
#chatBtn i[hidden],#chat .tab i[hidden]{display:none}
#chat{position:fixed;left:0;top:0;bottom:0;width:min(92vw,340px);z-index:61;display:flex;flex-direction:column;background:#fff;color:#222;box-shadow:6px 0 30px rgba(0,0,0,.25);transform:translateX(-105%);transition:transform .45s var(--ease)}
#chat.open{transform:none}
#chat header{display:flex;align-items:center;gap:6px;padding:10px 12px;border-bottom:1px solid #eee}
#chat header b{font:800 14px 'Rubik',sans-serif;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#chBack,#chClose{border:0;background:none;cursor:pointer;font-size:16px}
.tabs{display:flex;gap:4px}
#chat .tab{border:1px solid #ddd;border-radius:8px;padding:2px 8px;font-size:11px;background:#fff;cursor:pointer}
#chat .tab.sel{background:var(--accent);color:#fff;border-color:var(--accent)}
#chBody{flex:1;overflow:auto;padding:8px 0}
#chBody h4{margin:10px 12px 4px;font-size:11px;opacity:.6}
#chBody .mut{margin:10px 12px}
.msg{display:flex;gap:8px;padding:4px 12px;font-size:12px}.mb{min-width:0}
.mh{display:flex;gap:6px;align-items:baseline}.mt{font-size:9px;opacity:.5}
.mx{word-break:break-word;white-space:pre-wrap}
#chInput{display:flex;gap:6px;padding:8px;border-top:1px solid #eee}
#chInput[hidden]{display:none}
#chInput input{flex:1;min-width:0;font:12px 'Fira Code',monospace;border:1px solid #ccc;border-radius:8px;padding:6px 8px}
.fr-row{display:flex;align-items:center;gap:8px;padding:5px 12px;font-size:12px}.fr-row .btn{padding:3px 8px;font-size:10px}
.pcard{padding:0!important;overflow:hidden;position:relative;width:min(100%,340px)}
#pBanner{height:108px;background:#f0455a}
.pcard{background:#1e1f22;color:#f2f3f5;border:1px solid rgba(255,255,255,.1)}
.pcard .pfp{border-color:#1e1f22;width:84px;height:84px;margin-top:-44px}
.pcard .pfp.on::after{content:"";position:absolute;right:-2px;bottom:-2px;width:20px;height:20px;border-radius:50%;background:#23a55a;border:4px solid #1e1f22}
.pcard #pBio{opacity:.85}
.pcard #pEdit input[type=text],.pcard #pEdit input:not([type]),.pcard #pEdit textarea{background:#2b2d31;color:#f2f3f5;border-color:#3f4147}
.pbody{padding:0 18px 18px}
.pfp{display:grid;place-items:center;width:76px;height:76px;margin-top:-38px;border-radius:50%;border:4px solid #fff;color:#fff;font:800 28px 'Rubik',sans-serif;background:#888;position:relative}
#pName{margin:8px 0 2px;font:800 18px 'Rubik',sans-serif}
#pBio{margin:0 0 10px;font-size:12px;opacity:.8;white-space:pre-wrap;word-break:break-word}
#pClose{position:absolute;top:8px;right:10px;border:0;border-radius:50%;width:26px;height:26px;background:rgba(0,0,0,.4);color:#fff;cursor:pointer}
#pEdit input[type=text],#pEdit input:not([type]),#pEdit textarea{width:100%;margin:6px 0;padding:6px;font:12px 'Fira Code',monospace;border:1px solid #ccc;border-radius:8px}
#pEdit textarea{height:60px;resize:none}
.tsw{width:22px;height:22px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px #999;cursor:pointer;padding:0;transition:transform .15s}.tsw:hover{transform:scale(1.2)}
/* extras */
#tools{display:flex;gap:6px;align-items:center;justify-content:center;flex-wrap:wrap;width:min(92vw,720px);margin:0 auto 14px;padding:6px 10px;border-radius:14px;background:rgba(255,255,255,.6);color:#222}
#tools select,#tools input[type=search]{font:11px 'Fira Code',monospace;border:1px solid #ccc;border-radius:8px;padding:4px 8px;background:#fff;color:#222;min-width:0}
#tools input[type=search]{flex:1;min-width:120px}
.chip.sel{background:#222;color:#fff}
#exp{font:10px 'Fira Code',monospace;border:1px solid #ccc;border-radius:6px;padding:2px 4px;max-width:140px}
#stTray{margin-top:8px;padding-top:8px;border-top:1px dashed #ddd}
.emo{display:flex;flex-wrap:wrap;gap:2px;margin-bottom:6px}
.emo button{border:0;background:none;font-size:20px;cursor:pointer;padding:2px;border-radius:6px;transition:transform .15s}.emo button:hover{transform:scale(1.3)}
.au{width:16px;height:16px;border-radius:50%;display:grid;place-items:center;font:800 9px 'Rubik',sans-serif;color:#fff;flex:none}
.note.dim{opacity:.18;pointer-events:none;filter:grayscale(.6)}
.typing{font-style:italic;opacity:.8}
body.dk .sub{background:rgba(0,0,0,.35)}
.pref{display:flex;gap:8px;align-items:center;font-size:12px;margin:6px 0}
#trashList .tr{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #eee;font-size:11px}
#trashList img{height:32px}.tt{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#trashList .btn{background:#222;padding:3px 8px;font-size:10px}.mut{opacity:.6;font-size:11px;margin:4px 0}
#toast{position:fixed;left:50%;bottom:20px;transform:translate(-50%,80px);opacity:0;z-index:80;display:flex;gap:12px;align-items:center;padding:8px 14px;background:#222;color:#fff;border-radius:10px;font-size:12px;transition:all .35s var(--ease);pointer-events:none}
#toast.show{transform:translate(-50%,0);opacity:1;pointer-events:auto}
#toast button{border:0;background:none;color:#ffd166;font:inherit;cursor:pointer;text-decoration:underline}
.cur{position:absolute;left:0;top:0;transition:transform .09s linear}
.cur span{position:absolute;left:14px;top:12px;font-size:10px;color:#fff;padding:1px 6px;border-radius:8px;white-space:nowrap}
#dv{width:100%;max-width:320px;aspect-ratio:1;border:2px dashed #ccc;border-radius:10px;touch-action:none;cursor:crosshair;background:#fff;display:block;margin:10px auto 0}
.drow{display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap}
/* stickers */
.sk{position:absolute;pointer-events:auto;touch-action:none;cursor:grab;user-select:none;filter:drop-shadow(0 3px 5px rgba(0,0,0,.3));transition:filter .2s,transform .2s}
.sk.new{animation:pop .45s var(--ease)}
.sk.drag{cursor:grabbing;transform:scale(1.05);filter:drop-shadow(0 10px 14px rgba(0,0,0,.35));transition:none}
.sk img{width:100%;display:block;pointer-events:none;-webkit-user-drag:none}
.sk .x,.sk .rz{position:absolute;opacity:0;transition:opacity .2s}
.sk .x{top:-8px;right:-8px;width:20px;height:20px;padding:0;border-radius:50%;border:0;background:#222;color:#fff;font-size:11px;line-height:1;cursor:pointer}
.sk .rz{right:-6px;bottom:-6px;width:16px;height:16px;border-radius:50%;background:var(--accent);border:2px solid #fff;cursor:nwse-resize}
.sk:hover .x,.sk:hover .rz,.sk.drag .x{opacity:1}
@media(hover:none){.sk .x,.sk .rz{opacity:1}}
/* online */
#online{display:flex;justify-content:center;align-items:center;gap:6px;flex-wrap:wrap;margin:-10px auto 18px;width:max-content;max-width:92vw;padding:4px 12px;border-radius:20px;background:rgba(255,255,255,.6);color:#222;font-size:11px}
.live{width:8px;height:8px;border-radius:50%;background:#2ecc71;animation:ping 1.8s infinite}
@keyframes ping{0%{box-shadow:0 0 0 0 rgba(46,204,113,.6)}100%{box-shadow:0 0 0 8px rgba(46,204,113,0)}}
.av{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;color:#fff;font:800 11px 'Rubik',sans-serif;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.25);animation:pop .4s var(--ease)}
.av.me{outline:2px solid #222;outline-offset:1px}
/* gate (notebook home) */
#syncBox textarea{width:100%;height:90px;margin-top:8px;padding:6px;font:10px monospace;border:1px solid #ccc;border-radius:2px}
.gate{--rb:'Source Sans 3','Source Sans Pro','Segoe UI',Arial,sans-serif;position:fixed;inset:0;z-index:50;overflow:auto;color:#222;font-family:var(--rb);text-align:left;background-color:#fff;background-image:linear-gradient(rgba(74,134,196,.22) 1px,transparent 1px),linear-gradient(90deg,rgba(74,134,196,.22) 1px,transparent 1px);background-size:26px 26px;transition:opacity .55s .2s var(--ease),visibility .8s}
.gate.out{opacity:0;visibility:hidden;pointer-events:none}
.gate .gbar{position:sticky;top:0;z-index:3;height:64px;background:#fff;border-bottom:1px solid #d6d6d6;box-shadow:0 3px 0 rgba(0,0,0,.05);animation:barIn .5s var(--ease) backwards;transition:transform .5s var(--ease)}
.gate.out .gbar{transform:translateY(-100%)}
.gate .gbar>div{max-width:1000px;height:100%;margin:0 auto;padding:0 16px;display:flex;align-items:center;gap:6px}
.gate .glogo-s{display:flex;align-items:center;gap:9px;margin-right:16px;color:#1f3540;font:700 21px var(--rb);letter-spacing:.3px}
.gate .glogo-s i{display:grid;place-items:center;width:34px;height:34px;background:#e03a3a;color:#fff;font:800 20px 'Rubik',sans-serif;font-style:normal;border-radius:4px;transform:rotate(-6deg);box-shadow:0 0 0 2px #fff inset,2px 2px 0 rgba(0,0,0,.18)}
.gate .gnav a{display:inline-block;padding:20px 14px 17px;color:#666;font:600 17px var(--rb);text-decoration:none;border-bottom:3px solid transparent;cursor:pointer;transition:color .2s,border-color .25s,background .2s}
.gate .gnav a:hover{color:var(--accent);background:rgba(0,0,0,.03)}.gate .gnav a.sel{color:var(--accent);border-bottom-color:var(--accent)}
.gate .gbar .sp{flex:1}
.gate .gbar .gbadge{color:#888;font:italic 400 14px var(--rb)}
.gate .gmain{position:relative;z-index:1;max-width:1000px;min-height:calc(100vh - 64px);margin:0 auto;padding:40px 16px;display:flex;justify-content:space-between;align-items:flex-start;gap:28px;flex-wrap:wrap}
.gate .glogo{margin-top:90px;max-width:480px;animation:logoIn .7s var(--ease) backwards;transition:transform .5s var(--ease),opacity .4s}
.gate.out .glogo{transform:translateX(-80px) rotate(-5deg);opacity:0}
.gate .glogo .lg{display:inline-block;padding:2px 18px 6px;background:#e03a3a;color:#fff;font:800 clamp(38px,6vw,62px)/1.1 'Rubik',sans-serif;letter-spacing:1px;border:5px solid #fff;outline:3px solid #b32323;transform:rotate(-3deg);text-shadow:2px 3px 0 #8f1717;box-shadow:4px 6px 0 rgba(0,0,0,.25)}
.gate .glogo .tag{display:block;margin-top:16px;padding:10px 16px;background:rgba(40,52,60,.78);color:#fff;font:400 clamp(19px,3vw,27px)/1.2 var(--rb);border:0}
.gate .gcol{width:min(100%,444px)}
.gate .gview{display:none}
.gate .gview.on{display:block;animation:viewIn .45s var(--ease) backwards;transition:transform .45s var(--ease),opacity .35s}
.gate.out .gview.on{transform:translateY(-40px) scale(.95);opacity:0}
.gate .gpanel{background:#fff;padding:16px 16px 18px;margin-bottom:16px;border:2px solid #2b2b2b;box-shadow:6px 6px 0 rgba(0,0,0,.13)}
.gate .gpanel h2{margin:0 0 12px 2px;font:600 24px var(--rb);color:#222}
.gate .gpanel input[type=text],.gate .gpanel input[type=password]{display:block;width:100%;height:47px;margin:0 0 10px;padding:0 14px;font:400 17px var(--rb);color:#222;text-align:left;letter-spacing:0;background:#fff;border:1px solid #b9b9b9;border-radius:0;transition:border-color .2s,box-shadow .2s}
