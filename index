  {id:'g-green',name:'Green metal',bg:'linear-gradient(135deg,#0d4a2e,#2ecc71 45%,#c8f2d9 55%,#157a4a)',accent:'#3be08a',line:'rgba(255,255,255,.10)',dark:1},
  {id:'g-blue',name:'Blue metal',bg:'linear-gradient(135deg,#0b2a4a,#3a82c4 45%,#cfe4f7 55%,#1d5a96)',accent:'#6ab4ee',line:'rgba(255,255,255,.10)',dark:1},
